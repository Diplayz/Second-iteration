{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch file",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${file}" // Debugs the currently open Go file
        },
        {
            "name": "Launch package",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}" // Debugs the main package in the workspace root
        },
        {
            "name": "Launch test function",
            "type": "go",
            "request": "launch",
            "mode": "test",
            "program": "${file}",
            "args": [
                "-test.run",
                "TestMyFunction" // Replace with your test function name
            ]
        }
    ]
}